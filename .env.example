# ==============================================================================
# Lyftr AI - Environment Configuration
# ==============================================================================

# Comma-separated LLM API key pool (at least 2 keys required for failover)
# Internal IDs key_1, key_2, ... are assigned in this exact order.
# Real keys must NEVER be committed to version control.
LLM_API_KEYS=your_first_api_key_here,your_second_api_key_here

# SQLite database URL. Under Docker, this lives in the named volume mounted at /data.
# Example: sqlite:////data/app.db (Unix/Docker) or sqlite:///./data/app.db (Local)
DATABASE_URL=sqlite:////data/app.db

# Comma-separated list of allowed CORS origins for FastAPI
# Include your Vercel frontend URL for production deployment
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://lyftr-ai-full-stack-assignment.vercel.app

# Enables the failover test hook via the X-Simulate-Failure header
ENABLE_FAILURE_SIMULATION=true

# LiteLLM model identifier to use (e.g., gemini/gemini-3.8-flash)
LLM_MODEL=gemini/gemini-3.8-flash

# Per-request timeout in seconds for LiteLLM completion calls (defaults to 20.0s)
LLM_REQUEST_TIMEOUT=20.0

# LiteLLM cache type: local (in-memory) or disk
CACHE_TYPE=local

# Default system prompt for new conversation sessions
DEFAULT_SYSTEM_PROMPT=You are a helpful and concise AI assistant.

# Frontend API base URL (used during frontend build / deployment)
VITE_BACKEND_URL=http://localhost:8000

